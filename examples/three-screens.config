# Example: portrait + ultrawide + landscape monitors on one Linux desktop,
# arranged left to right. Replace MAC_HOST and the BetterDisplay tags.
MAC_HOST=my-mac.local
MAC_JITTER_SECONDS=60

SCREENS="left center right"
PRIMARY_SCREEN=center

# Mac desktop (logical points): portrait at x=-1080, ultrawide main display at
# 0,0, landscape to its right. Stream/window values are in Linux pixels.
SCREEN_LEFT_TAG=5
SCREEN_LEFT_WIDTH=1200
SCREEN_LEFT_HEIGHT=2133
SCREEN_LEFT_FPS=60
SCREEN_LEFT_BITRATE=60
SCREEN_LEFT_WINDOW_X=0
SCREEN_LEFT_WINDOW_Y=0
SCREEN_LEFT_MAC_X=-1080
SCREEN_LEFT_MAC_Y=-184
SCREEN_LEFT_MAC_WIDTH=1080
SCREEN_LEFT_MAC_HEIGHT=1920

SCREEN_CENTER_TAG=6
SCREEN_CENTER_WIDTH=3440
SCREEN_CENTER_HEIGHT=1440
SCREEN_CENTER_FPS=120
SCREEN_CENTER_BITRATE=60
SCREEN_CENTER_WINDOW_X=1200
SCREEN_CENTER_WINDOW_Y=309
SCREEN_CENTER_MAC_X=0
SCREEN_CENTER_MAC_Y=0

SCREEN_RIGHT_TAG=3
SCREEN_RIGHT_WIDTH=1920
SCREEN_RIGHT_HEIGHT=1080
SCREEN_RIGHT_FPS=60
SCREEN_RIGHT_BITRATE=20
SCREEN_RIGHT_WINDOW_X=4640
SCREEN_RIGHT_WINDOW_Y=451
SCREEN_RIGHT_MAC_X=3440
SCREEN_RIGHT_MAC_Y=153

# Built-in MacBook panel (tag 2) is blanked while streaming.
INTERNAL_SCREEN_TAG=2
UNMIRROR_FROM=Color LCD
