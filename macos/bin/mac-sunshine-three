#!/bin/zsh

set -u

betterdisplay='/Applications/BetterDisplay.app/Contents/MacOS/BetterDisplay'
sunshine_app='/Applications/Sunshine.app'
session_helper="$HOME/.local/bin/mac-sunshine-session"
config_root="$HOME/.config"
lock_file="$config_root/sunshine-three-supervisor.lock"
# Written by mac-sunshine-session once the Mac is back to normal. While it
# exists, the session helper skips re-applying the display and keyboard
# settings, so this loop cannot fight the user's own brightness keys.
idle_marker="$config_root/sunshine-three-idle"

# Keep one supervisor alive from login until logout. This lets BetterDisplay
# be turned off during normal Mac use and brought back without manual repair.
if [[ "${1:-}" != --locked ]]; then
  exec /usr/bin/lockf -k -t 0 "$lock_file" /bin/zsh "$0" --locked
fi
trap 'exit 0' INT TERM

# Clear leases left behind by a forced logout or a Sunshine crash.
"$session_helper" expire >/dev/null 2>&1 || true

display_id_for_tag() {
  local id
  id=$("$betterdisplay" get -tagID="$1" -identifiers 2>/dev/null \
    | /usr/bin/awk -F'"' '/"displayID"/ { print $4; exit }')
  [[ "$id" == <-> && "$id" != 0 ]] && print -r -- "$id"
}

sunshine_port_open() {
  /usr/sbin/lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
}

set_display_ids() {
  right_id=$(display_id_for_tag 3)
  left_id=$(display_id_for_tag 5)
  center_id=$(display_id_for_tag 6)
  [[ -n "$right_id" && -n "$left_id" && -n "$center_id" ]]
}

sunshine_ports_ready() {
  sunshine_port_open 47989 && sunshine_port_open 48189 && sunshine_port_open 48389
}

config_output_name() {
  /usr/bin/awk -F'= ' '/^output_name = / { print $2; exit }' "$1"
}

stop_sunshine() {
  pkill -f '/Applications/Sunshine.app/Contents/MacOS/Sunshine' >/dev/null 2>&1 || true
  sleep 1
}

start_instance() {
  local side="$1"
  local port="$2"
  local config="$config_root/sunshine-$side/sunshine.conf"

  /usr/bin/open -n -a "$sunshine_app" --args "$config" >/dev/null 2>&1 &
  for _ in {1..20}; do
    if sunshine_port_open "$port"; then
      return 0
    fi
    sleep 1
  done

  # macOS can occasionally drop an open request while starting several
  # instances at once. Retry once, but only if the expected port is absent.
  /usr/bin/open -n -a "$sunshine_app" --args "$config" >/dev/null 2>&1 &
  for _ in {1..20}; do
    if sunshine_port_open "$port"; then
      return 0
    fi
    sleep 1
  done
  print -u2 "Sunshine $side instance did not open port $port"
  return 1
}

restart_sunshine() {
  # A vanished Sunshine instance means its lease will never be refreshed.
  # Only start the countdown once Sunshine is really capturing. Before that,
  # macOS is still handing out display IDs and powering down would race the
  # client's acquire hook.
  if ! "$session_helper" has-active && sunshine_ports_ready; then
    "$session_helper" expire >/dev/null 2>&1 || true
  fi
  # Turning the virtual screens off can leave macOS in a mirrored
  # arrangement. Restore the extended desktop before Sunshine probes capture.
  "$betterdisplay" set -displayID="$center_id" -mirror=off \
    -targetnamelike='Color LCD,Virtuel 16:9' >/dev/null 2>&1 || true

  sed -i '' "s/^output_name = .*/output_name = $left_id/" \
    "$config_root/sunshine-left/sunshine.conf"
  sed -i '' "s/^output_name = .*/output_name = $center_id/" \
    "$config_root/sunshine-center/sunshine.conf"
  sed -i '' "s/^output_name = .*/output_name = $right_id/" \
    "$config_root/sunshine-right/sunshine.conf"

  stop_sunshine
  start_instance left 47989 || true
  start_instance center 48189 || true
  start_instance right 48389 || true
}

sleep 12
idle_since=0
while true; do
  # BetterDisplay keeps stable tag IDs for these virtual screens while macOS
  # may assign new capture/display IDs after a reboot or reconnect. Waiting
  # here also handles virtual screens being enabled later in the session.
  if ! set_display_ids; then
    "$session_helper" expire >/dev/null 2>&1 || true
    if pgrep -f '/Applications/Sunshine.app/Contents/MacOS/Sunshine' >/dev/null 2>&1; then
      stop_sunshine
    fi
    sleep 2
    continue
  fi
  # The screens are up, so whatever the helper restored no longer applies.
  rm -f "$idle_marker"

  # The screens are up but no stream holds a lease. Give a connecting client
  # time to run its acquire hook, then power them back down.
  if ! "$session_helper" has-active; then
    if (( idle_since == 0 )); then
      idle_since=$SECONDS
    elif (( SECONDS - idle_since > 90 )); then
      "$session_helper" expire >/dev/null 2>&1 || true
      idle_since=0
    fi
  else
    idle_since=0
  fi

  needs_restart=0
  [[ "$(config_output_name "$config_root/sunshine-left/sunshine.conf")" == "$left_id" ]] || needs_restart=1
  [[ "$(config_output_name "$config_root/sunshine-center/sunshine.conf")" == "$center_id" ]] || needs_restart=1
  [[ "$(config_output_name "$config_root/sunshine-right/sunshine.conf")" == "$right_id" ]] || needs_restart=1
  sunshine_port_open 47989 || needs_restart=1
  sunshine_port_open 48189 || needs_restart=1
  sunshine_port_open 48389 || needs_restart=1

  if (( needs_restart )); then
    restart_sunshine
  fi
  sleep 5
done
