<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mac-three-screens.mouse-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>@HOME@/.local/bin/mac-mouse-bridge</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>@HOME@/.config/mac-mouse-bridge.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/.config/mac-mouse-bridge.log</string>
</dict>
</plist>
