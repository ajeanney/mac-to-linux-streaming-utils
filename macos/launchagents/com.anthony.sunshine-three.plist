<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.anthony.sunshine-three</string>
  <key>ProgramArguments</key>
  <array>
    <string>@HOME@/.local/bin/mac-sunshine-three</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- Without this, a supervisor that dies for any reason silently stops
       refreshing Sunshine's capture IDs and every stream fails with 503. -->
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>@HOME@/.config/sunshine-three-autostart.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/.config/sunshine-three-autostart.log</string>
</dict>
</plist>
