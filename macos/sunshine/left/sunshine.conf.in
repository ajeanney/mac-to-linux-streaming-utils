sunshine_name = Mac-Left-Portrait
output_name = 10
port = 47989
encoder = videotoolbox
vt_realtime = enabled
minimum_fps_target = 60
stream_audio = false
mouse = disabled
keyboard = disabled
keybindings = [ 0xC0, 0xE2 ]
origin_web_ui_allowed = lan
file_apps = @HOME@/.config/sunshine-left/apps.json
file_state = @HOME@/.config/sunshine-left/sunshine_state.json
credentials_file = @HOME@/.config/sunshine-left/credentials.json
pkey = @HOME@/.config/sunshine-left/credentials/cakey.pem
cert = @HOME@/.config/sunshine-left/credentials/cacert.pem
log_path = @HOME@/.config/sunshine-left/sunshine.log
