sunshine_name = Mac-Right-Landscape
output_name = 9
port = 48389
encoder = videotoolbox
vt_realtime = enabled
minimum_fps_target = 60
stream_audio = false
mouse = disabled
keyboard = disabled
keybindings = [ 0xC0, 0xE2 ]
origin_web_ui_allowed = lan
file_apps = @HOME@/.config/sunshine-right/apps.json
file_state = @HOME@/.config/sunshine-right/sunshine_state.json
credentials_file = @HOME@/.config/sunshine-right/credentials.json
pkey = @HOME@/.config/sunshine-right/credentials/cakey.pem
cert = @HOME@/.config/sunshine-right/credentials/cacert.pem
log_path = @HOME@/.config/sunshine-right/sunshine.log
