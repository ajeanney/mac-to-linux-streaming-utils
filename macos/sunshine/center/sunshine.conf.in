sunshine_name = Mac-Center-Ultrawide
output_name = 11
port = 48189
encoder = videotoolbox
vt_realtime = enabled
minimum_fps_target = 120
stream_audio = false
mouse = disabled
keyboard = enabled
keybindings = [ 0xC0, 0xE2 ]
origin_web_ui_allowed = lan
file_apps = @HOME@/.config/sunshine-center/apps.json
file_state = @HOME@/.config/sunshine-center/sunshine_state.json
credentials_file = @HOME@/.config/sunshine-center/credentials.json
pkey = @HOME@/.config/sunshine-center/credentials/cakey.pem
cert = @HOME@/.config/sunshine-center/credentials/cacert.pem
log_path = @HOME@/.config/sunshine-center/sunshine.log
