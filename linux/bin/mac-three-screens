#!/usr/bin/env bash

set -u

cfg="$HOME/.local/bin/mac-three-screens-config"
units=()
while read -r name; do units+=("mac-three-screens@$name.service"); done < <("$cfg" names)
[ "${#units[@]}" -gt 0 ] || { echo "No screens configured; check ~/.config/mac-three-screens/config" >&2; exit 2; }
command=${1:-status}

stop_streams() {
  systemctl --user stop "${units[@]}" || return
  local host_file="$HOME/.local/state/mac-three-screens/host" host
  if [ -f "$host_file" ]; then
    read -r host < "$host_file"
    "$HOME/.local/bin/mac-screens-wake" release "$host" all || return
  fi
  return 0
}

case "$command" in
  start|restart)
    "$cfg" check linux || exit 2
    stop_streams || echo "Could not confirm previous session cleanup; trying a new session." >&2
    systemctl --user start "${units[@]}"
    export DISPLAY="${DISPLAY:-:0}"
    if [ -z "${XAUTHORITY:-}" ]; then
      XAUTHORITY=$(find "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" -maxdepth 1 -type f -name 'xauth_*' -print -quit 2>/dev/null)
      export XAUTHORITY
    fi
    # Keep the primary stream as the keyboard focus after all windows have
    # been created. Pointer movement remains free to cross all windows.
    primary_title="Mac-$("$cfg" primary)"
    for _ in $(seq 1 60); do
      center_window=''
      for candidate in $(/usr/bin/xdotool search --class moonlight 2>/dev/null); do
        window_name=$(/usr/bin/xdotool getwindowname "$candidate" 2>/dev/null || true)
        case "$window_name" in
          "$primary_title"*) center_window=$candidate; break ;;
        esac
      done
      if [ -n "$center_window" ]; then
        /usr/bin/xdotool windowactivate --sync "$center_window" 2>/dev/null || true
        break
      fi
      sleep 0.25
    done
    ;;
  stop)
    stop_streams || exit 1
    ;;
  status)
    systemctl --user --no-pager --full status "${units[@]}"
    ;;
  *)
    echo "usage: $0 start | restart | stop | status" >&2
    exit 2
    ;;
esac
