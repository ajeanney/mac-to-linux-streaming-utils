#!/usr/bin/env bash

set -u

side=${1:-}
profile=${MAC_SCREENS_PROFILE:-stable}

mac_name=${MAC_MOUSE_BRIDGE_ADDRESS:-FR-K3KFKV6TFX.local}
mac_host=''

port_open() {
  timeout 1 bash -c "</dev/tcp/$1/47989" >/dev/null 2>&1
}

rtt() {
  ping -n -c 1 -W 1 "$1" 2>/dev/null | awk -F/ '/^rtt / { print $5; exit }'
}

# mDNS answers with both the Mac's wired and wireless addresses. Rank them by
# ping so the streams stay on the gigabit link.
ranked_candidates() {
  {
    # mDNS can be late after a Mac reboot. Try the last working IPv4 host too.
    if [ -f "$HOME/.local/state/mac-three-screens/host" ]; then
      awk '/^[0-9]+(\.[0-9]+){3}$/' "$HOME/.local/state/mac-three-screens/host"
    fi
    if [[ "$mac_name" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
      printf '%s\n' "$mac_name"
    fi
    if command -v avahi-resolve-host-name >/dev/null 2>&1; then
      avahi-resolve-host-name -4 "$mac_name" 2>/dev/null | awk '{print $2}'
    fi
    getent ahostsv4 "$mac_name" 2>/dev/null | awk '{print $1}'
  } | awk 'NF && !seen[$0]++' | while read -r candidate; do
    value=$(rtt "$candidate")
    [ -n "$value" ] || value=9999
    printf '%s %s\n' "$value" "$candidate"
  done | sort -n | awk '{print $2}'
}

# Last resort when mDNS is down and the Mac moved: sweep the wired subnet.
# Slow (neighbour table plus nmap), so it only runs when nothing answered.
sweep_candidates() {
  wired_interface=$(ip route show default 2>/dev/null \
    | awk '$1 == "default" { for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }')
  [ -n "$wired_interface" ] || return 0
  ip neigh show dev "$wired_interface" 2>/dev/null \
    | awk '$1 ~ /^[0-9]+(\.[0-9]+){3}$/ { print $1 }'
  wired_cidr=$(ip -4 route show dev "$wired_interface" scope link 2>/dev/null \
    | awk '$1 ~ /^[0-9]+(\.[0-9]+){3}\/[0-9]+$/ { print $1; exit }')
  if [ -n "$wired_cidr" ] && command -v nmap >/dev/null 2>&1; then
    nmap -n -p 47989 --open --max-retries 1 --host-timeout 1s \
      "$wired_cidr" -oG - 2>/dev/null \
      | awk '/Ports: 47989\/open/ { print $2 }'
  fi
}

# Sunshine is stopped while the virtual screens are idle. Wake them through
# the always-on Mac mouse bridge before looking for the Sunshine host ports.
for candidate in $(ranked_candidates); do
  if "$HOME/.local/bin/mac-screens-wake" wake "$candidate"; then
    mac_host=$candidate
    break
  fi
done

if [ -z "$mac_host" ]; then
  for candidate in $(sweep_candidates | awk '!seen[$0]++'); do
    if port_open "$candidate" && "$HOME/.local/bin/mac-screens-wake" wake "$candidate"; then
      mac_host=$candidate
      break
    fi
  done
fi

if [ -z "$mac_host" ]; then
  echo "Could not wake the Mac or prepare its virtual displays; check BetterDisplay and the Mac supervisor." >&2
  exit 1
fi

# The bridge follows the actual stream address, including after a reboot or
# network change. Write atomically because all three launchers share it.
state_dir="$HOME/.local/state/mac-three-screens"
mkdir -p "$state_dir"
printf '%s\n' "$mac_host" > "$state_dir/host.$$"
mv "$state_dir/host.$$" "$state_dir/host"

case "$side:$profile" in
  left:stable)
    title='Mac-Left-Portrait'
    config_home="$HOME/.config/moonlight-left"
    host="${mac_host}:47989"
    resolution='1200x2133'
    fps=60
    bitrate=60000
    target_x=0
    target_y=0
    ;;
  center:stable)
    title='Mac-Center-Ultrawide'
    config_home="$HOME/.config/moonlight-center"
    host="${mac_host}:48189"
    resolution='3440x1440'
    fps=120
    bitrate=60000
    target_x=1200
    target_y=309
    ;;
  right:stable)
    title='Mac-Right-Landscape'
    config_home="$HOME/.config/moonlight-right"
    host="${mac_host}:48389"
    resolution='1920x1080'
    fps=60
    bitrate=20000
    target_x=4640
    target_y=451
    ;;
  left:high)
    title='Mac-Left-Portrait'
    config_home="$HOME/.config/moonlight-left"
    host="${mac_host}:47989"
    resolution='1200x2133'
    fps=60
    bitrate=60000
    target_x=0
    target_y=0
    ;;
  center:high)
    title='Mac-Center-Ultrawide'
    config_home="$HOME/.config/moonlight-center"
    host="${mac_host}:48189"
    resolution='3440x1440'
    fps=120
    bitrate=60000
    target_x=1200
    target_y=309
    ;;
  right:high)
    title='Mac-Right-Landscape'
    config_home="$HOME/.config/moonlight-right"
    host="${mac_host}:48389"
    resolution='1920x1080'
    fps=60
    bitrate=20000
    target_x=4640
    target_y=451
    ;;
  *)
    echo "usage: $0 left|center|right" >&2
    exit 2
    ;;
esac

export XDG_CONFIG_HOME="$config_home"
export QT_QPA_PLATFORM=xcb
export SDL_VIDEODRIVER=x11
export DISPLAY="${DISPLAY:-:0}"

if [ -z "${XAUTHORITY:-}" ]; then
  XAUTHORITY=$(find "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" -maxdepth 1 -type f -name 'xauth_*' -print -quit 2>/dev/null)
  export XAUTHORITY
fi

if [ "$side" != center ]; then
  export SDL_AUDIODRIVER=dummy
fi

child_pid=''
heartbeat_pid=''
released=''

release_lease() {
  if [ -n "$heartbeat_pid" ]; then
    kill "$heartbeat_pid" 2>/dev/null || true
    heartbeat_pid=''
  fi
  if [ -z "$released" ]; then
    released=1
    # Tell the Mac this stream is done so it can power its virtual screens
    # down now instead of waiting out the lease.
    "$HOME/.local/bin/mac-screens-wake" release "$mac_host" "$side" >/dev/null 2>&1 || true
  fi
}

cleanup() {
  release_lease
  if [ -n "$child_pid" ]; then
    kill "$child_pid" 2>/dev/null || true
    child_pid=''
  fi
  # Stopped on purpose: report success so systemd does not mark the unit
  # failed (and does not restart it).
  exit 0
}
trap cleanup INT TERM

/usr/bin/moonlight stream \
  --resolution "$resolution" \
  --fps "$fps" \
  --bitrate "$bitrate" \
  --video-codec HEVC \
  --video-decoder hardware \
  --display-mode windowed \
  --no-vsync \
  --no-frame-pacing \
  --capture-system-keys always \
  --absolute-mouse \
  --no-audio-on-host \
  "$host" Desktop &
child_pid=$!

# Keep the Mac's virtual screens powered for as long as this stream runs.
# When the stream ends this loop stops, the lease on the Mac goes stale, and
# the Mac powers the screens back down on its own.
(
  while kill -0 "$child_pid" 2>/dev/null; do
    "$HOME/.local/bin/mac-screens-wake" heartbeat "$mac_host" >/dev/null || true
    sleep 45
  done
) &
heartbeat_pid=$!

window_id=''
for _ in $(seq 1 100); do
  for candidate in $(xdotool search --class moonlight 2>/dev/null); do
    window_name=$(xdotool getwindowname "$candidate" 2>/dev/null || true)
    case "$window_name" in
      "$title"*)
        window_id=$candidate
        break
        ;;
    esac
  done

  if [ -n "$window_id" ]; then
    xdotool windowmove "$window_id" "$target_x" "$target_y" 2>/dev/null || true
    sleep 0.2
    xdotool windowstate --add FULLSCREEN "$window_id" 2>/dev/null || true
    # Moonlight sees the KDE Wayland session through one XWayland display and
    # otherwise enables its fullscreen pointer-region lock. Disable that lock
    # so the Linux pointer can cross between the three stream windows.
    sleep 0.2
    xdotool windowfocus "$window_id" 2>/dev/null || true
    sleep 0.2
    xdotool key --window "$window_id" ctrl+alt+shift+l 2>/dev/null || true
    # Keep the Linux cursor visible in the keyboard-focused center stream.
    # The Moonlight client-cursor toggle can stop rendering after pointer leave/enter.
    if [ "$side" = center ]; then
      xdotool key --window "$window_id" ctrl+alt+shift+c 2>/dev/null || true
    fi
    # The side streams are viewers. Keep their keyboard/mouse capture off so
    # they cannot overwrite the global Mac pointer controlled by the bridge.
    if [ "$side" != center ]; then
      xdotool key --window "$window_id" ctrl+alt+shift+z 2>/dev/null || true
    fi
    for candidate in $(xdotool search --class moonlight 2>/dev/null); do
      window_name=$(xdotool getwindowname "$candidate" 2>/dev/null || true)
      if [ "$window_name" = 'Moonlight' ]; then
        xdotool windowminimize "$candidate" 2>/dev/null || true
      fi
    done
    break
  fi
  sleep 0.2
done

wait "$child_pid"
exit_code=$?
child_pid=''
if [ -n "$heartbeat_pid" ]; then
  kill "$heartbeat_pid" 2>/dev/null || true
  wait "$heartbeat_pid" 2>/dev/null || true
  heartbeat_pid=''
fi
# Moonlight exited: drop the lease too, whichever way the stream ended.
release_lease
trap - INT TERM
exit "$exit_code"
