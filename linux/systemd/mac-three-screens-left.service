[Unit]
Description=Moonlight Mac left portrait display
After=graphical-session.target

[Service]
EnvironmentFile=-%h/.config/mac-three-screens/environment
ExecStart=%h/.local/bin/moonlight-mac-display left
Restart=on-failure
RestartSec=2
StandardOutput=append:%h/.local/state/mac-three-screens/left.log
StandardError=append:%h/.local/state/mac-three-screens/left.log
