[Unit]
Description=Moonlight Mac center ultrawide display
After=graphical-session.target

[Service]
EnvironmentFile=-%h/.config/mac-three-screens/environment
ExecStart=%h/.local/bin/moonlight-mac-display center
Restart=on-failure
RestartSec=2
StandardOutput=append:%h/.local/state/mac-three-screens/center.log
StandardError=append:%h/.local/state/mac-three-screens/center.log
